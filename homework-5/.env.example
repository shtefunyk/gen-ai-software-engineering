# Homework 5 — required environment (NEVER put real values in a committed file)
#
# GitHub MCP reads the token from this variable via ${GITHUB_TOKEN} expansion
# in .mcp.json. Easiest source is your already-logged-in gh CLI:
#
#   export GITHUB_TOKEN=$(gh auth token)
#
GITHUB_TOKEN=

# Notion MCP uses browser OAuth (https://mcp.notion.com/mcp) — no token here.
# Filesystem MCP and the custom lorem server need no secrets.
